DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=3000
UPLOAD_DIR=./uploads
# 可选：设置后所有 /api/*（健康检查除外）必须携带 Bearer Token；本地单机可留空
API_TOKEN=
# 公开分发默认关闭。仅受控本地/答辩环境可临时从运行环境注入，切勿写入版本库
ALLOW_BUILTIN_KEYS=0
# BUILTIN_DEEPSEEK_KEY=
# BUILTIN_ZHIPU_KEY=
# CORS 白名单（逗号分隔）；不配置时默认放行 localhost:5173/4173。部署时改成你的前端域名
# CORS_ORIGIN=https://your-frontend-domain.com,http://localhost:5173
