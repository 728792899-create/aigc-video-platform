module.exports = {
  apps: [{
    name: 'aigc-backend',
    script: 'app.js',
    cwd: __dirname,
    // 崩溃自动重启
    autorestart: true,
    // 内存超过 1GB 自动重启（防止内存泄漏拖垮系统）
    max_memory_restart: '1G',
    // 重启间隔递增（防止疯狂重启）
    restart_delay: 2000,
    // 最多连续重启 10 次后停止
    max_restarts: 10,
    // 环境变量
    env: {
      NODE_ENV: 'production',
      PORT: 3000,
    },
    // 日志配置
    error_file: './logs/error.log',
    out_file: './logs/out.log',
    log_date_format: 'YYYY-MM-DD HH:mm:ss',
    // 合并日志（不按 PID 分文件）
    merge_logs: true,
    // 监听文件变化自动重启（开发时有用）
    watch: false,
  }]
};
