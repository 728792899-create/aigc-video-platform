{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "app.ts",
    "db/**/*.ts",
    "db/**/*.js",
    "middleware/**/*.ts",
    "middleware/**/*.js",
    "routes/**/*.ts",
    "routes/**/*.js",
    "services/**/*.ts",
    "services/**/*.js",
    "types/**/*.d.ts",
    "utils/**/*.ts",
    "utils/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "test", "scripts", "uploads", "logs", "**/* 2.ts", "**/* 2.js"]
}
