{
  "name": "aigc-director-studio",
  "version": "2.0.0",
  "private": true,
  "description": "AIGC 导演工作室 - clean-room、本地优先、可恢复的 AI 视频生产工作台",
  "author": "AIGC Director Studio Contributors",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "apps/desktop/dist/main.cjs",
  "scripts": {
    "build:packages": "pnpm --filter @local/ai-video-director-prompt-pack build && pnpm --filter @aigc-director/contracts build && pnpm --filter @aigc-director/model-catalog build && pnpm --filter @aigc-director/domain build && pnpm --filter @aigc-director/agents build && pnpm --filter @aigc-director/providers build && pnpm --filter @aigc-director/media build",
    "build": "pnpm build:packages && pnpm --filter @aigc-director/server build && pnpm --filter @aigc-director/studio build && pnpm --filter @aigc-director/desktop build",
    "dev": "pnpm build:packages && node scripts/dev-v2.mjs",
    "demo": "pnpm dev",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "lint": "eslint apps packages scripts --max-warnings=0",
    "test": "cross-env DEMO_MODE=1 PROVIDER_NETWORK_DISABLED=1 pnpm -r --if-present test",
    "test:smoke": "cross-env DEMO_MODE=1 PROVIDER_NETWORK_DISABLED=1 pnpm exec vitest run packages/testing/test/smoke.test.ts",
    "test:electron": "pnpm --filter @aigc-director/desktop test",
    "test:ffmpeg": "node scripts/ffmpeg-smoke.mjs",
    "security:scan": "node scripts/security-check.mjs",
    "clean-room:check": "node scripts/clean-room-check.mjs",
    "quality": "pnpm typecheck && pnpm lint && pnpm test && pnpm clean-room:check && pnpm security:scan && pnpm test:ffmpeg && pnpm build && pnpm test:smoke",
    "electron:dev": "pnpm build && cross-env AIGC_DIRECTOR_SKIP_LEGACY_PURGE=1 electron .",
    "prepare:package": "node scripts/prepare-package.mjs",
    "prepare:desktop-stage": "node scripts/prepare-desktop-stage.mjs",
    "electron:preflight": "node scripts/electron-preflight.mjs",
    "desktop:launch-smoke": "node scripts/desktop-launch-smoke.mjs",
    "desktop:open:demo": "node scripts/open-packaged-desktop.mjs",
    "release:verify-credentials": "node scripts/verify-release-credentials.mjs",
    "pack": "pnpm build && pnpm prepare:package && pnpm electron:preflight && pnpm prepare:desktop-stage && node scripts/package-desktop.mjs",
    "dist": "pnpm build && pnpm prepare:package && pnpm electron:preflight && pnpm prepare:desktop-stage && pnpm release:verify-credentials && electron-builder --projectDir .desktop-stage -c.electronDist=../node_modules/electron/dist"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "40.10.6",
    "electron-builder": "26.15.3",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.9.2",
    "tsx": "4.23.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1"
  },
  "build": {
    "appId": "com.aigc.director.studio",
    "productName": "AIGC 导演工作室",
    "artifactName": "AIGC-Director-Studio-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron",
      "buildResources": "resources"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": ".package-stage/server", "to": "server" },
      { "from": "apps/studio/dist", "to": "studio" },
      { "from": "LICENSE", "to": "LICENSE" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }
    ],
    "afterPack": "scripts/after-pack.mjs",
    "afterSign": "scripts/notarize.mjs",
    "publish": [{ "provider": "github", "owner": "728792899-create", "repo": "aigc-video-platform", "releaseType": "draft" }],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }, { "target": "zip", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": { "rfc3161TimeStampServer": "http://timestamp.digicert.com" }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIGC 导演工作室",
      "deleteAppDataOnUninstall": false
    }
  }
}
