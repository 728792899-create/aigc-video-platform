node_modules/
**/node_modules/

# Retired 1.x trees may still contain local runtime copies. They are never
# part of the 2.0 monorepo or a public commit.
/client/
/server/
/electron/

# Build and packaging output
**/dist/
dist-electron/
.package-stage/
.desktop-stage/
dist-server-jsc/
*.tgz
*.dmg
*.pkg
*.exe
*.msi
*.blockmap

# Local runtime and user data
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.log
logs/
uploads/
media/
# Keep the first-party media workspace package in source control. The rule
# above only targets runtime media directories.
!packages/media/
!packages/media/package.json
!packages/media/tsconfig.json
!packages/media/src/
!packages/media/src/**
!packages/media/test/
!packages/media/test/**
exports/
runtime/

# Secrets and signing material
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cer
secrets.json

# Preserved local duplicate files; never stage these automatically.
* 2
* 2.*

# Tool and OS state
.DS_Store
Thumbs.db
.idea/
.vscode/
.cache/
.vite/
coverage/
*.tsbuildinfo
*.tmp
*.swp
