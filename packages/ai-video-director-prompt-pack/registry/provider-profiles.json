[
  {
    "id": "openai",
    "version": "1.0.0",
    "title": "OpenAI",
    "family": "openai",
    "transport": "native",
    "baseUrl": "https://api.openai.com",
    "auth": {
      "scheme": "bearer",
      "header": "Authorization",
      "secretRefRequired": true
    },
    "modalities": [
      "text",
      "image",
      "video"
    ],
    "features": [
      "text",
      "structured-output",
      "bilingual",
      "image-generation",
      "video-generation",
      "first-frame",
      "reference-images",
      "async"
    ],
    "async": true,
    "supportsCancel": false,
    "supportsReconcile": true,
    "prompt": {
      "languages": [
        "zh",
        "en"
      ],
      "negativePrompt": "field",
      "referenceSyntax": "api-field"
    },
    "notes": [
      "视频、图像和文本端点按能力配置；模型ID由项目能力目录提供。"
    ]
  },
